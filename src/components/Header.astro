---
import { salon, nav } from "../data/site";

interface Props {
  variant?: "solid" | "overlay";
}

const { variant = "solid" } = Astro.props;
const isOverlay = variant === "overlay";

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
---

<header
  id="site-header"
  class={
    isOverlay
      ? "header-overlay fixed top-0 inset-x-0 z-50 border-b transition-colors duration-300"
      : "sticky top-0 z-50 bg-canvas/95 backdrop-blur border-b border-line transition-colors duration-300"
  }
>
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <div class="flex items-center justify-between py-4">
      <a href="/" class="brand group flex flex-col leading-none text-ink transition-colors duration-300">
        <span class="font-display font-black text-xl tracked uppercase">
          {salon.short}
        </span>
        <span class="eyebrow text-[0.6rem] text-accent mt-1">
          Hair Studio &mdash; {salon.area}
        </span>
      </a>

      <nav aria-label="Primary" class="hidden md:block">
        <ul class="primary-nav flex items-center gap-8 font-display text-sm font-bold uppercase tracked">
          {
            nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isActive(item.href) ? "page" : undefined}
                  class={`pb-1 border-b-2 transition-colors ${
                    isActive(item.href)
                      ? "border-accent"
                      : "border-transparent hover:border-accent-soft"
                  }`}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <a
        href="/booking/"
        class={
          isOverlay
            ? "hidden md:inline-flex items-center gap-2 bg-ink/90 text-canvas backdrop-blur-sm font-display font-bold text-sm uppercase tracked px-5 py-2.5 rounded-full shadow-lg hover:bg-accent hover:text-ink transition-colors"
            : "hidden md:inline-flex items-center gap-2 bg-accent text-ink font-display font-bold text-sm uppercase tracked px-5 py-2.5 rounded-full shadow-sm hover:bg-ink hover:text-canvas transition-colors"
        }
      >
        Book a chair
      </a>

      <button
        id="menu-toggle"
        type="button"
        class="menu-toggle md:hidden font-display font-bold text-sm uppercase tracked border-2 border-ink rounded-full px-4 py-2 text-ink transition-colors duration-300"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        Menu
      </button>
    </div>

    <nav
      id="mobile-nav"
      aria-label="Primary mobile"
      class="hidden md:hidden pb-5"
    >
      <ul class="primary-nav flex flex-col gap-1 font-display font-bold text-base uppercase tracked">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? "page" : undefined}
                class={`block py-2.5 border-b border-line ${
                  isActive(item.href) ? "text-accent" : ""
                }`}
              >
                {item.label}
              </a>
            </li>
          ))
        }
        <li class="pt-3">
          <a
            href="/booking/"
            class="inline-flex bg-accent text-ink font-bold text-sm px-5 py-2.5 rounded-full"
          >
            Book a chair
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById("site-header");
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-nav");

  toggle?.addEventListener("click", () => {
    const expanded = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!expanded));
    menu?.classList.toggle("hidden");
    updateOverlaySolid();
  });

  // Overlay header (homepage hero): starts transparent over the photo,
  // solidifies once the visitor scrolls past the hero or opens the mobile
  // menu, so nav stays legible in both states.
  function updateOverlaySolid() {
    if (!header?.classList.contains("header-overlay")) return;
    const menuOpen = !menu?.classList.contains("hidden");
    header.classList.toggle("is-solid", window.scrollY > 24 || menuOpen);
  }

  if (header?.classList.contains("header-overlay")) {
    updateOverlaySolid();
    window.addEventListener("scroll", updateOverlaySolid, { passive: true });
  }
</script>
