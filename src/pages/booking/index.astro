---
import Layout from "../../layouts/Layout.astro";

/**
 * DEMO NOTE — this is a real Calendly inline embed, connected to a free-tier
 * test account with a single event type, used only to preview how a live
 * booking widget looks and behaves on the site. It is not the final setup
 * for a real client.
 *
 * When this site goes live for an actual client (Premium package), swap the
 * data-url below for the client's own Calendly link (their account must
 * already exist — never create one on their behalf). If an inline embed
 * doesn't fit the layout, a Calendly popup button linking out is the
 * alternative.
 */
---

<Layout
  title="Booking"
  description="Request an appointment at Wren Hair Studio in Clapham — choose a service, stylist and time, then confirm your details."
>
  <section class="mx-auto max-w-6xl px-5 sm:px-8 pt-14 sm:pt-20 pb-10">
    <p class="eyebrow text-accent text-xs sm:text-sm mb-4">Request an appointment</p>
    <h1 class="font-display font-black uppercase text-4xl sm:text-5xl leading-[1.05] tracking-tight text-ink max-w-2xl">
      Book a <span class="text-accent">chair</span>
    </h1>
    <p class="mt-6 text-lg text-ink-soft max-w-xl leading-relaxed">
      Pick a service, a stylist and a time that works — your appointment is
      confirmed instantly, with a reminder sent straight to your inbox.
    </p>
  </section>

  <section class="reveal mx-auto max-w-6xl px-5 sm:px-8 pb-24">
    <div id="booking-widget" class="grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-8 rounded-2xl border border-line bg-paper shadow-md p-2 sm:p-4">
        <!--
          Real Calendly inline embed, for a test with the user's own free-tier
          account (single event type). Swap data-url for the client's own
          Calendly link when this is reused for a real customer.
        -->
        <div
          class="calendly-inline-widget"
          data-url="https://calendly.com/giuseppes90"
          style="min-width:320px;height:700px;"
        >
        </div>
      </div>

      <aside class="lg:col-span-4">
        <div class="rounded-2xl bg-canvas-alt shadow-md p-6 sticky top-28">
          <p class="eyebrow text-accent text-xs mb-4">
            Good to know
          </p>
          <ul class="space-y-4 text-sm text-ink-soft leading-relaxed">
            <li>
              <span class="block font-display font-black text-ink text-xs uppercase tracked mb-1">Confirmation</span>
              Your slot is booked instantly &mdash; you'll get an email
              confirmation and an automatic reminder ahead of time.
            </li>
            <li>
              <span class="block font-display font-black text-ink text-xs uppercase tracked mb-1">Cancellations</span>
              Need to change plans? Use the reschedule or cancel link in your
              confirmation email &mdash; no need to call.
            </li>
            <li>
              <span class="block font-display font-black text-ink text-xs uppercase tracked mb-1">First visit?</span>
              Add a note above and we'll allow extra time for a consultation.
            </li>
          </ul>
        </div>
      </aside>
    </div>
  </section>
</Layout>

<script src="https://assets.calendly.com/assets/external/widget.js" async></script>
