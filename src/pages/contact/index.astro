---
import Layout from "../../layouts/Layout.astro";
import ColourRail from "../../components/ColourRail.astro";
import ConsentCheckbox from "../../components/ConsentCheckbox.astro";
import { salon } from "../../data/site";
---

<Layout
  title="Contact"
  description="Get in touch with Wren Hair Studio in Clapham — find our address, phone number, opening hours and a contact form."
>
  <section class="mx-auto max-w-6xl px-5 sm:px-8 pt-14 sm:pt-20 pb-10">
    <p class="eyebrow text-accent text-base mb-4">Find us</p>
    <h1 class="font-display font-semibold text-4xl sm:text-5xl leading-[1.05] tracking-tight text-ink max-w-2xl">
      Get in touch
    </h1>
    <p class="mt-6 text-lg text-ink-soft max-w-xl leading-relaxed">
      Questions about a service, a colour change you're nervous about, or
      just want to check we've got space this week &mdash; send us a message
      and we'll reply personally.
    </p>
    <ColourRail class="mt-10 max-w-xs" tabHeight="h-2" />
  </section>

  <section class="reveal mx-auto max-w-6xl px-5 sm:px-8 pb-24 grid gap-10 lg:grid-cols-12">
    <div class="lg:col-span-7 border border-line bg-paper p-6 sm:p-10">
      <!--
        Netlify Forms: this form is detected at deploy time because of the
        data-netlify attribute and the hidden form-name field below. It
        submits over fetch so visitors get an inline confirmation without a
        page reload. No third-party form backend or account is used.
      -->
      <form
        id="contact-form"
        name="contact"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        class="space-y-5"
      >
        <input type="hidden" name="form-name" value="contact" />
        <p class="hidden">
          <label>Don't fill this out if you're human: <input name="bot-field" /></label>
        </p>

        <div class="grid sm:grid-cols-2 gap-5">
          <div>
            <label for="c-name" class="block text-sm text-ink-soft mb-1.5">Full name</label>
            <input id="c-name" name="name" type="text" required autocomplete="name"
              class="w-full border border-line bg-canvas px-4 py-2.5 text-ink focus:border-accent outline-none" />
          </div>
          <div>
            <label for="c-phone" class="block text-sm text-ink-soft mb-1.5">Phone (optional)</label>
            <input id="c-phone" name="phone" type="tel" autocomplete="tel"
              class="w-full border border-line bg-canvas px-4 py-2.5 text-ink focus:border-accent outline-none" />
          </div>
        </div>

        <div>
          <label for="c-email" class="block text-sm text-ink-soft mb-1.5">Email</label>
          <input id="c-email" name="email" type="email" required autocomplete="email"
            class="w-full border border-line bg-canvas px-4 py-2.5 text-ink focus:border-accent outline-none" />
        </div>

        <div>
          <label for="c-message" class="block text-sm text-ink-soft mb-1.5">Message</label>
          <textarea id="c-message" name="message" rows="5" required
            class="w-full border border-line bg-canvas px-4 py-2.5 text-ink focus:border-accent outline-none"></textarea>
        </div>

        <ConsentCheckbox id="contact-consent" name="consent" />

        <button
          type="submit"
          class="inline-flex items-center justify-center bg-ink text-canvas font-display uppercase tracked text-sm px-8 py-4 hover:bg-accent transition-colors"
        >
          Send message
        </button>

        <p
          id="contact-confirmation"
          role="status"
          class="hidden border border-accent bg-canvas-alt text-ink px-5 py-4 text-sm"
        >
          Thanks &mdash; your message has been sent. We'll get back to you
          within one working day.
        </p>
        <p
          id="contact-error"
          role="alert"
          class="hidden border border-swatch-copper bg-canvas-alt text-ink px-5 py-4 text-sm"
        >
          Something went wrong sending your message. Please call us on
          {salon.phone} instead.
        </p>
      </form>
    </div>

    <div class="lg:col-span-5 space-y-6">
      <div class="border border-line bg-canvas-alt p-6">
        <p class="font-display text-sm uppercase tracked text-ink-faint mb-3">Studio</p>
        <p class="text-ink-soft leading-relaxed">
          {salon.addressLine1}<br />
          {salon.addressLine2}
        </p>
        <p class="mt-4 text-ink-soft">
          <a class="hover:text-accent" href={salon.phoneHref}>{salon.phone}</a><br />
          <a class="hover:text-accent" href={`mailto:${salon.email}`}>{salon.email}</a>
        </p>
        <div class="flex gap-5 mt-4 font-display text-sm uppercase tracked">
          <a class="text-accent hover:text-ink" href={salon.instagram} target="_blank" rel="noopener noreferrer">Instagram</a>
          <a class="text-accent hover:text-ink" href={salon.facebook} target="_blank" rel="noopener noreferrer">Facebook</a>
        </div>
      </div>

      <div class="border border-line bg-canvas-alt p-6">
        <p class="font-display text-sm uppercase tracked text-ink-faint mb-3">Opening hours</p>
        <ul class="text-sm text-ink-soft space-y-1.5">
          {
            salon.hours.map((h) => (
              <li class="flex justify-between gap-4">
                <span>{h.day}</span>
                <span>{h.time}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Static map embed placeholder — no API key required. Swap for a
           live Google Maps / OpenStreetMap embed with the client's exact
           address once confirmed. -->
      <div class="border border-line overflow-hidden">
        <iframe
          title="Map showing the approximate location of Wren Hair Studio on Abbeville Road, Clapham"
          src="https://www.openstreetmap.org/export/embed.html?bbox=-0.1425%2C51.4585%2C-0.1325%2C51.4635&layer=mapnik&marker=51.4610%2C-0.1375"
          class="w-full h-64 border-0"
          loading="lazy"
        ></iframe>
      </div>
    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const confirmation = document.getElementById("contact-confirmation");
  const errorMsg = document.getElementById("contact-error");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    errorMsg?.classList.add("hidden");

    const data = new FormData(form);
    try {
      // Netlify's documented AJAX submission pattern: POST the encoded form
      // data to "/" so the deployed site's Netlify Forms handler picks it
      // up. Locally (no Netlify runtime) this request will fail, which is
      // expected — the inline UI still gives a clear result either way.
      await fetch("/", {
        method: "POST",
        headers: { "Content-Type": "application/x-www-form-urlencoded" },
        body: new URLSearchParams(data as unknown as Record<string, string>).toString(),
      });
      confirmation?.classList.remove("hidden");
      form.reset();
    } catch {
      errorMsg?.classList.remove("hidden");
    }
    confirmation?.scrollIntoView({ behavior: "smooth", block: "nearest" });
  });
</script>
