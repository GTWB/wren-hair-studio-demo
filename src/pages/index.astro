---
import Layout from "../layouts/Layout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { salon, serviceCategories, team, galleryImages } from "../data/site";

const previewImages = galleryImages.slice(0, 4);

// A handful of representative services, pulled straight from the real price
// list in data/site.ts, for the "Our prices" highlight section.
const allServices = serviceCategories.flatMap((cat) => cat.services);
const highlightNames = [
  "Signature Cut",
  "Balayage",
  "Root Tint",
  "Men's Cut",
  "Blow-dry & Style",
  "Bond Repair Treatment",
];
const priceHighlights = highlightNames
  .map((name) => allServices.find((s) => s.name === name))
  .filter(Boolean);
---

<Layout
  title="Modern Hair Salon in Clapham"
  description="Wren Hair Studio is an independent hair salon in Clapham, London, offering precision cutting, hand-painted colour and considered treatments. Book your chair today."
  headerVariant="overlay"
>
  <!-- Hero — one full-bleed photo, header floats transparent on top of it -->
  <section class="relative bg-ink overflow-hidden">
    <div class="relative h-[86vh] min-h-[560px] sm:h-[88vh] lg:h-screen lg:max-h-[980px]">
      <img
        src="https://images.unsplash.com/photo-1633681926022-84c23e8cb2d6?auto=format&fit=crop&w=1800&h=1600&q=80"
        alt="Stylist finishing a client's haircut in front of a mirror at Wren Hair Studio"
        class="absolute inset-0 h-full w-full object-cover"
        loading="eager"
        fetchpriority="high"
        width="1800"
        height="1600"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-ink/70 via-ink/25 to-ink/40" aria-hidden="true"></div>
      <div
        class="absolute inset-0"
        style="background: radial-gradient(60% 50% at 50% 50%, rgb(42 23 13 / 0.55) 0%, rgb(42 23 13 / 0.15) 70%, transparent 100%);"
        aria-hidden="true"
      >
      </div>

      <!-- Title — centred over the full-bleed photo -->
      <div class="absolute inset-0 flex items-center justify-center px-5 sm:px-8">
        <div class="max-w-3xl text-center">
          <h1 class="font-display font-black uppercase text-5xl sm:text-7xl lg:text-8xl leading-[0.92] tracking-tight text-canvas text-balance">
            Where every<br />cut has time
          </h1>
          <p class="mt-5 sm:mt-7 text-sm sm:text-base text-canvas/85 max-w-md mx-auto leading-relaxed">
            Wren is a small studio on Abbeville Road, built around one idea: hair
            planned around you, cut by people who take the time to look properly
            before they pick up the scissors.
          </p>
          <div class="mt-8 sm:mt-10 flex flex-wrap items-center justify-center gap-4">
            <a
              href="/booking/"
              class="inline-flex items-center bg-accent text-ink font-display font-bold uppercase tracked text-sm px-7 py-3.5 rounded-full shadow-lg shadow-ink/20 hover:bg-canvas transition-colors"
            >
              Book a chair
            </a>
            <a
              href="/services/"
              class="inline-flex items-center border border-canvas/60 text-canvas font-display font-bold uppercase tracked text-sm px-7 py-3.5 rounded-full hover:bg-canvas/10 hover:border-canvas transition-colors"
            >
              See services &amp; prices
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Care beyond the chair — dark band, copy + stylised map -->
  <section class="reveal bg-ink text-canvas">
    <div class="mx-auto max-w-6xl px-5 sm:px-8 py-20 sm:py-28 grid gap-14 lg:grid-cols-2 lg:items-center">
      <div>
        <p class="eyebrow text-accent-soft text-xs sm:text-sm mb-4">
          Since 2017 &mdash; {salon.area}
        </p>
        <h2 class="font-display font-black text-3xl sm:text-4xl lg:text-5xl uppercase leading-[1.05] tracking-tight text-canvas text-balance">
          Care that goes<br />beyond the chair
        </h2>
        <p class="mt-6 text-canvas/70 max-w-md leading-relaxed">
          Two minutes from Clapham South station, Wren runs on one rule: three
          stylists, each with their own focus, and one chair at a time per
          stylist. No double-booking, no rushing &mdash; your appointment is
          the only one happening in that chair.
        </p>
        <a
          href="/about/"
          class="mt-8 inline-flex items-center bg-accent text-ink font-display font-bold uppercase tracked text-sm px-7 py-3.5 rounded-full hover:bg-canvas transition-colors"
        >
          Meet the studio
        </a>
      </div>

      <div class="space-y-4">
        <div class="relative rounded-2xl overflow-hidden border border-canvas/15">
          <iframe
            title="Map showing the approximate location of Wren Hair Studio on Abbeville Road, Clapham"
            src="https://www.openstreetmap.org/export/embed.html?bbox=-0.1425%2C51.4585%2C-0.1325%2C51.4635&layer=mapnik&marker=51.4610%2C-0.1375"
            class="w-full h-56 sm:h-64 border-0 grayscale contrast-125 sepia-[.4] opacity-90"
            loading="lazy"
          ></iframe>
          <div class="absolute inset-0 bg-ink/35 mix-blend-multiply pointer-events-none" aria-hidden="true"></div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="bg-canvas/5 border border-canvas/15 rounded-xl p-5">
            <span
              class="flex h-9 w-9 items-center justify-center rounded bg-accent text-ink mb-3"
              aria-hidden="true"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-5 w-5">
                <path
                  d="M12 22s7-7.58 7-12.5A7 7 0 0 0 5 9.5C5 14.42 12 22 12 22Z"
                  stroke="currentColor"
                  stroke-width="1.8"
                />
                <circle cx="12" cy="9.5" r="2.4" stroke="currentColor" stroke-width="1.8" />
              </svg>
            </span>
            <p class="eyebrow text-[0.65rem] text-canvas/50 mb-1">Location</p>
            <p class="text-sm text-canvas/85 leading-snug">
              {salon.addressLine1}<br />
              {salon.addressLine2}
            </p>
          </div>
          <div class="bg-canvas/5 border border-canvas/15 rounded-xl p-5">
            <span
              class="flex h-9 w-9 items-center justify-center rounded bg-accent text-ink mb-3"
              aria-hidden="true"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-5 w-5">
                <path
                  d="M6.6 10.8c1.4 2.8 3.8 5.2 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.4c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1L6.6 10.8Z"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linejoin="round"
                />
              </svg>
            </span>
            <p class="eyebrow text-[0.65rem] text-canvas/50 mb-1">Phone</p>
            <p class="text-sm text-canvas/85 leading-snug">
              <a class="hover:text-accent-soft" href={salon.phoneHref}>{salon.phone}</a>
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Discover our works -->
  <section class="reveal mx-auto max-w-6xl px-5 sm:px-8 py-20 sm:py-24">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <SectionHeading eyebrow="Recent work" title="Discover our finishes" />
      <a
        href="/gallery/"
        class="font-display font-bold uppercase tracked text-sm text-accent hover:text-ink"
      >
        View full gallery &rarr;
      </a>
    </div>
    <p class="mt-4 max-w-xl text-ink-soft leading-relaxed">
      A running record of what leaves the chair each week &mdash; cuts, colour
      and the occasional finishing detail.
    </p>
    <div class="mt-10 grid grid-cols-2 sm:grid-cols-4 gap-4">
      {
        previewImages.map((img) => (
          <img
            src={img.src}
            alt={img.alt}
            loading="lazy"
            width="900"
            height="1100"
            class="w-full h-56 sm:h-64 object-cover rounded-xl shadow-md"
          />
        ))
      }
    </div>
  </section>

  <!-- Our prices -->
  <section class="reveal bg-canvas-alt border-y border-line">
    <div class="mx-auto max-w-4xl px-5 sm:px-8 py-20 sm:py-24">
      <div class="text-center mb-14">
        <p class="eyebrow text-accent text-xs sm:text-sm mb-3">A few favourites</p>
        <h2 class="font-display font-black text-4xl sm:text-5xl md:text-6xl uppercase tracking-tight text-ink">
          Our <span class="text-accent">prices</span>
        </h2>
      </div>
      <ul class="divide-y divide-line">
        {
          priceHighlights.map((s) => (
            <li class="flex items-baseline justify-between gap-6 py-5">
              <div>
                <p class="font-display font-bold uppercase tracked text-ink">{s!.name}</p>
                <p class="text-sm text-ink-soft mt-1 max-w-md">{s!.desc}</p>
              </div>
              <p class="font-display font-black text-lg text-accent whitespace-nowrap">{s!.price}</p>
            </li>
          ))
        }
      </ul>
      <div class="mt-10 text-center">
        <a
          href="/services/"
          class="inline-flex items-center border-2 border-ink text-ink font-display font-bold uppercase tracked text-sm px-7 py-3.5 rounded-full hover:bg-ink hover:text-canvas transition-colors"
        >
          See full price list
        </a>
      </div>
    </div>
  </section>

  <!-- Meet our experts -->
  <section class="reveal mx-auto max-w-6xl px-5 sm:px-8 py-20 sm:py-24">
    <SectionHeading eyebrow="Behind the chair" title="Meet our experts" />
    <div class="mt-10 grid gap-8 sm:grid-cols-3">
      {
        team.map((member) => (
          <div class="group">
            <div class="overflow-hidden rounded-2xl">
              <img
                src={member.image}
                alt={member.alt}
                loading="lazy"
                width="600"
                height="750"
                class="w-full h-80 sm:h-96 object-cover transition-transform duration-500 group-hover:scale-105"
              />
            </div>
            <h3 class="mt-5 font-display font-black text-lg uppercase tracked text-ink">
              {member.name}
            </h3>
            <p class="eyebrow text-accent text-xs mt-1">{member.role}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- CTA — dark band -->
  <section class="reveal bg-ink text-canvas">
    <div class="mx-auto max-w-6xl px-5 sm:px-8 py-16 sm:py-20 flex flex-col sm:flex-row sm:items-center gap-8 sm:justify-between">
      <div>
        <h2 class="font-display font-black text-3xl sm:text-4xl text-canvas text-balance">
          Ready for your next appointment?
        </h2>
        <p class="mt-3 text-canvas/70">
          Chairs go quickly on Saturdays &mdash; book ahead where you can.
        </p>
      </div>
      <a
        href="/booking/"
        class="inline-flex items-center justify-center bg-accent text-ink font-display font-bold uppercase tracked text-sm px-8 py-4 rounded-full shadow-lg shadow-accent/20 hover:bg-canvas transition-colors whitespace-nowrap"
      >
        Book a chair
      </a>
    </div>
  </section>
</Layout>
