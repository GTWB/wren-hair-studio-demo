---
import Layout from "../layouts/Layout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ColourRail from "../components/ColourRail.astro";
import { salon, serviceCategories, testimonials, galleryImages } from "../data/site";

const previewImages = galleryImages.slice(0, 4);
---

<Layout
  title="Modern Hair Salon in Clapham"
  description="Wren Hair Studio is an independent hair salon in Clapham, London, offering precision cutting, hand-painted colour and considered treatments. Book your chair today."
>
  <!-- Hero -->
  <section class="mx-auto max-w-6xl px-5 sm:px-8 pt-14 sm:pt-20 pb-16 grid gap-10 lg:grid-cols-12 lg:items-center">
    <div class="lg:col-span-6">
      <p class="eyebrow text-accent text-base mb-4">Independent hair studio &mdash; {salon.area}</p>
      <h1 class="font-display font-semibold text-4xl sm:text-5xl md:text-6xl leading-[1.05] tracking-tight text-ink">
        Cut and colour,<br /> considered.
      </h1>
      <p class="mt-6 text-lg text-ink-soft max-w-md leading-relaxed">
        Wren is a small studio on Abbeville Road built around one idea: hair
        that's planned around you, cut by people who take the time to look
        properly before they pick up the scissors.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a
          href="/booking/"
          class="inline-flex items-center bg-ink text-canvas font-display uppercase tracked text-sm px-6 py-3.5 hover:bg-accent transition-colors"
        >
          Book a chair
        </a>
        <a
          href="/services/"
          class="inline-flex items-center border border-ink text-ink font-display uppercase tracked text-sm px-6 py-3.5 hover:border-accent hover:text-accent transition-colors"
        >
          See services &amp; prices
        </a>
      </div>
      <ColourRail class="mt-10 max-w-xs" tabHeight="h-2" />
    </div>

    <div class="lg:col-span-6">
      <img
        src="https://images.unsplash.com/photo-1633681926022-84c23e8cb2d6?auto=format&fit=crop&w=1200&h=1400&q=80"
        alt="Stylist finishing a client's haircut in front of a mirror at Wren Hair Studio"
        class="w-full h-[420px] sm:h-[520px] object-cover"
        loading="eager"
        fetchpriority="high"
        width="1200"
        height="1400"
      />
    </div>
  </section>

  <!-- Intro strip -->
  <section class="bg-canvas-alt border-y border-line">
    <div class="mx-auto max-w-6xl px-5 sm:px-8 py-14 grid gap-10 md:grid-cols-3">
      <div>
        <p class="font-display text-4xl text-accent">2017</p>
        <p class="mt-2 text-sm text-ink-soft leading-relaxed">
          Open since 2017 on Abbeville Road, a two-minute walk from Clapham
          South station.
        </p>
      </div>
      <div>
        <p class="font-display text-4xl text-accent">3</p>
        <p class="mt-2 text-sm text-ink-soft leading-relaxed">
          Three stylists, each with their own focus &mdash; cutting, colour and
          finishing &mdash; so you're always booked with the right person.
        </p>
      </div>
      <div>
        <p class="font-display text-4xl text-accent">1 chair</p>
        <p class="mt-2 text-sm text-ink-soft leading-relaxed">
          At a time, per stylist. No double-booking, no rushing &mdash; your
          appointment is the only one happening in that chair.
        </p>
      </div>
    </div>
  </section>

  <!-- Services in brief -->
  <section class="mx-auto max-w-6xl px-5 sm:px-8 py-20">
    <SectionHeading eyebrow="What we do" title="Three ways to book" />
    <div class="mt-10 grid gap-px bg-line sm:grid-cols-3 border border-line">
      {
        serviceCategories.map((cat) => (
          <div class="bg-canvas p-8 flex flex-col">
            <span
              class="h-1.5 w-10 mb-6"
              style={{ backgroundColor: cat.swatch }}
              aria-hidden="true"
            />
            <h3 class="font-display text-xl uppercase tracked text-ink">
              {cat.label}
            </h3>
            <p class="mt-3 text-sm text-ink-soft leading-relaxed flex-1">
              {cat.intro}
            </p>
            <a
              href="/services/"
              class="mt-6 text-sm font-display uppercase tracked text-accent hover:text-ink inline-flex items-center gap-1"
            >
              View prices &rarr;
            </a>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Gallery preview -->
  <section class="bg-ink text-canvas py-20">
    <div class="mx-auto max-w-6xl px-5 sm:px-8">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <SectionHeading
          eyebrow="Recent work"
          title="From the studio floor"
          class="[&_h2]:text-canvas [&_p]:text-accent-soft"
        />
        <a
          href="/gallery/"
          class="font-display uppercase tracked text-sm text-accent-soft hover:text-canvas"
        >
          View full gallery &rarr;
        </a>
      </div>
      <div class="mt-10 grid grid-cols-2 sm:grid-cols-4 gap-3">
        {
          previewImages.map((img) => (
            <img
              src={img.src}
              alt={img.alt}
              loading="lazy"
              width="900"
              height="1100"
              class="w-full h-56 sm:h-64 object-cover"
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="mx-auto max-w-6xl px-5 sm:px-8 py-20">
    <SectionHeading eyebrow="Word of mouth" title="What clients say" />
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {
        testimonials.map((t) => (
          <figure class="border border-line p-7 flex flex-col bg-paper">
            <blockquote class="eyebrow text-lg text-ink leading-snug flex-1">
              &ldquo;{t.quote}&rdquo;
            </blockquote>
            <figcaption class="mt-6 text-sm text-ink-soft">
              <span class="font-display uppercase tracked text-ink">{t.author}</span>
              <br />
              {t.context}
            </figcaption>
          </figure>
        ))
      }
    </div>
  </section>

  <!-- CTA -->
  <section class="mx-auto max-w-6xl px-5 sm:px-8 pb-24">
    <div class="bg-canvas-alt border border-line px-8 py-14 sm:px-14 flex flex-col sm:flex-row sm:items-center gap-8 sm:justify-between">
      <div>
        <h2 class="font-display font-semibold text-2xl sm:text-3xl text-ink">
          Ready for your next appointment?
        </h2>
        <p class="mt-2 text-ink-soft">
          Chairs go quickly on Saturdays &mdash; book ahead where you can.
        </p>
      </div>
      <a
        href="/booking/"
        class="inline-flex items-center justify-center bg-ink text-canvas font-display uppercase tracked text-sm px-7 py-4 hover:bg-accent transition-colors whitespace-nowrap"
      >
        Book a chair
      </a>
    </div>
  </section>
</Layout>
