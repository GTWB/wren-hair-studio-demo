---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Page not found"
  description="The page you're looking for doesn't exist at Wren Hair Studio."
>
  <section class="mx-auto max-w-2xl px-5 sm:px-8 py-28 text-center">
    <p class="eyebrow text-accent text-base mb-4">404</p>
    <h1 class="font-display font-black uppercase text-4xl sm:text-5xl text-ink">
      That page has grown out.
    </h1>
    <p class="mt-6 text-lg text-ink-soft">
      The page you're looking for doesn't exist. Try one of the links below
      instead.
    </p>
    <a
      href="/"
      class="mt-8 inline-flex items-center bg-ink text-canvas font-display font-bold uppercase tracked text-sm px-6 py-3.5 rounded-full hover:bg-accent transition-colors"
    >
      Back to home
    </a>
  </section>
</Layout>
