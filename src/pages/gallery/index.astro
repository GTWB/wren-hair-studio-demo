---
import Layout from "../../layouts/Layout.astro";
import { galleryImages } from "../../data/site";
---

<Layout
  title="Gallery"
  description="Browse recent cuts, colour work and studio shots from Wren Hair Studio, an independent hair salon in Clapham, London."
>
  <section class="mx-auto max-w-6xl px-5 sm:px-8 pt-14 sm:pt-20 pb-10">
    <p class="eyebrow text-accent text-xs sm:text-sm mb-4">From the studio floor</p>
    <h1 class="font-display font-black uppercase text-4xl sm:text-5xl leading-[1.05] tracking-tight text-ink max-w-2xl">
      Gallery
    </h1>
    <p class="mt-6 text-lg text-ink-soft max-w-xl leading-relaxed">
      A mix of finished cuts, colour work and the studio itself &mdash; most
      of it shot on quiet Tuesday mornings between appointments.
    </p>
  </section>

  <section class="reveal mx-auto max-w-6xl px-5 sm:px-8 pb-24">
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
      {
        galleryImages.map((img, i) => (
          <figure class="group relative overflow-hidden rounded-xl shadow-md">
            <button
              type="button"
              class="lightbox-trigger block w-full cursor-zoom-in focus-visible:outline focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-2"
              data-index={i}
              aria-label={`View larger image: ${img.alt}`}
            >
              <img
                src={img.src}
                alt={img.alt}
                loading="lazy"
                width="900"
                height="1100"
                class="w-full h-52 sm:h-64 object-cover transition-transform duration-500 group-hover:scale-105"
              />
            </button>
            <span
              class="absolute bottom-0 left-0 h-1.5 w-full pointer-events-none"
              style={{ backgroundColor: img.swatch }}
              aria-hidden="true"
            />
          </figure>
        ))
      }
    </div>
  </section>

  <!-- Lightbox overlay -->
  <div
    id="lightbox"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-ink/95 p-4 sm:p-10"
    role="dialog"
    aria-modal="true"
    aria-label="Image preview"
  >
    <button
      type="button"
      id="lightbox-close"
      class="absolute top-4 right-4 sm:top-6 sm:right-6 text-canvas/80 hover:text-canvas text-sm font-display font-bold uppercase tracked border border-canvas/30 rounded-full px-4 py-2 focus-visible:outline focus-visible:outline-2 focus-visible:outline-accent"
      aria-label="Close preview"
    >
      Close &times;
    </button>
    <button
      type="button"
      id="lightbox-prev"
      class="absolute left-2 sm:left-6 top-1/2 -translate-y-1/2 text-canvas/80 hover:text-canvas text-3xl font-display px-3 py-2 focus-visible:outline focus-visible:outline-2 focus-visible:outline-accent"
      aria-label="Previous image"
    >
      &larr;
    </button>
    <button
      type="button"
      id="lightbox-next"
      class="absolute right-2 sm:right-6 top-1/2 -translate-y-1/2 text-canvas/80 hover:text-canvas text-3xl font-display px-3 py-2 focus-visible:outline focus-visible:outline-2 focus-visible:outline-accent"
      aria-label="Next image"
    >
      &rarr;
    </button>
    <figure class="max-w-4xl max-h-full">
      <img
        id="lightbox-image"
        src=""
        alt=""
        class="max-h-[80vh] w-auto mx-auto rounded-xl shadow-2xl"
      />
      <figcaption id="lightbox-caption" class="mt-4 text-center text-canvas/70 text-sm" />
    </figure>
  </div>
</Layout>

<script define:vars={{ images: galleryImages.map((img) => ({ src: img.src, alt: img.alt })) }}>
  const overlay = document.getElementById("lightbox");
  const imageEl = document.getElementById("lightbox-image");
  const captionEl = document.getElementById("lightbox-caption");
  const closeBtn = document.getElementById("lightbox-close");
  const prevBtn = document.getElementById("lightbox-prev");
  const nextBtn = document.getElementById("lightbox-next");
  const triggers = document.querySelectorAll(".lightbox-trigger");

  let currentIndex = 0;
  let lastFocused = null;

  function show(index) {
    currentIndex = (index + images.length) % images.length;
    const img = images[currentIndex];
    imageEl.src = img.src.replace(/w=\d+&h=\d+/, "w=1600&h=2000");
    imageEl.alt = img.alt;
    captionEl.textContent = img.alt;
  }

  function open(index) {
    lastFocused = document.activeElement;
    show(index);
    overlay.classList.remove("hidden");
    overlay.classList.add("flex");
    document.body.style.overflow = "hidden";
    closeBtn.focus();
  }

  function close() {
    overlay.classList.add("hidden");
    overlay.classList.remove("flex");
    document.body.style.overflow = "";
    imageEl.src = "";
    if (lastFocused instanceof HTMLElement) lastFocused.focus();
  }

  triggers.forEach((trigger) => {
    trigger.addEventListener("click", () => {
      open(Number(trigger.dataset.index));
    });
  });

  closeBtn.addEventListener("click", close);
  prevBtn.addEventListener("click", () => show(currentIndex - 1));
  nextBtn.addEventListener("click", () => show(currentIndex + 1));

  overlay.addEventListener("click", (e) => {
    if (e.target === overlay) close();
  });

  document.addEventListener("keydown", (e) => {
    if (overlay.classList.contains("hidden")) return;
    if (e.key === "Escape") close();
    if (e.key === "ArrowLeft") show(currentIndex - 1);
    if (e.key === "ArrowRight") show(currentIndex + 1);
  });
</script>
